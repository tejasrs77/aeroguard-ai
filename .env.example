# Day 4 runs fully offline by default with the deterministic grounded generator.
AEROGUARD_GENERATOR=local

# To enable optional OpenAI wording, copy this file to .env, set the two values,
# and change AEROGUARD_GENERATOR to openai. Never commit the real .env file.
OPENAI_API_KEY=
AEROGUARD_OPENAI_MODEL=gpt-5.5
